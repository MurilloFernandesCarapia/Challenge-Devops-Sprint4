="text;html=1;align=center;verticalAlign=middle;whiteSpace=nowrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D9E2EC;fontSize=11;fontStyle=1;fontColor=#334E68;spacing=4;" vertex="1" parent="1"><mxGeometry x="300" y="768" width="250" height="22" as="geometry" /></mxCell><mxCell id="v63" value="B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=14;shadow=1;fillColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="1063" y="760" width="30" height="30" as="geometry" /></mxCell><mxCell id="v64" value="C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=14;shadow=1;fillColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="1200" y="1025" width="30" height="30" as="geometry" /></mxCell><mxCell id="v65" value="EF Core · ODP.NET · TCP 1521" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=nowrap;rounded=1;fillColor=#FFFFFF;strokeColor=#D9E2EC;fontSize=11;fontStyle=1;fontColor=#334E68;spacing=4;" vertex="1" parent="1"><mxGeometry x="1240" y="1029" width="200" height="22" as="geometry" /></mxCell><mxCell id="v66" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Ordem da esteira CI/CD e fluxo da aplicação&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;width:100%;font-size:11.5px;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;width:50%;padding-right:10px&quot;&gt;&lt;b&gt;1&lt;/b&gt; Dev faz git push na branch master&lt;br&gt;&lt;b&gt;2&lt;/b&gt; O push dispara a pipeline de CI&lt;br&gt;&lt;b&gt;3&lt;/b&gt; CI: restore, build e 122 testes&lt;br&gt;&lt;b&gt;4&lt;/b&gt; CI publica o artefato petcare360-api&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Artefato novo dispara a pipeline de CD&lt;br&gt;&lt;b&gt;6&lt;/b&gt; CD lê os segredos 🔒 da Library&lt;/td&gt;&lt;td style=&quot;vertical-align:top;width:50%&quot;&gt;&lt;b&gt;7&lt;/b&gt; CD autentica via Service Connection&lt;br&gt;&lt;b&gt;8&lt;/b&gt; Deploy + App Settings no Web App&lt;br&gt;&lt;b&gt;9&lt;/b&gt; Smoke test GET /health/live&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#16A34A&quot;&gt;A&lt;/font&gt;&lt;/b&gt; Usuário → API via HTTPS + JWT&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#16A34A&quot;&gt;B&lt;/font&gt;&lt;/b&gt; API grava a auditoria no Cosmos DB&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#16A34A&quot;&gt;C&lt;/font&gt;&lt;/b&gt; API lê e grava o domínio no Oracle&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;arcSize=5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="915" width="580" height="180" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>